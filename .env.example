# ── USGS M2M API（补充客户端，usgs_m2m）────────────────────────
# 注册 https://ers.cr.usgs.gov/register 后申请 M2M API access
# https://ers.cr.usgs.gov/profile/access
USGS_M2M_USERNAME=
USGS_M2M_TOKEN=

# ── Copernicus Data Space Ecosystem（CDSE）─────────────────────
# OAuth2 client credentials：https://dataspace.copernicus.eu/ -> Profile -> Applications
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 备选：账号密码（仅 cdse_odata 走密码授权时使用）
CDSE_USERNAME=
CDSE_PASSWORD=

# ── 通用 ───────────────────────────────────────────────────────
# 数据根目录，默认 ./data
RSPIPE_DATA_ROOT=
# 日志级别 DEBUG/INFO/WARNING/ERROR
RSPIPE_LOG_LEVEL=INFO
