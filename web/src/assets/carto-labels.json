[
  {
    "id": "country",
    "type": "symbol",
    "source-layer": "place",
    "filter": ["==", ["get", "class"], "country"],
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": 15,
      "text-letter-spacing": 0.12,
      "text-max-width": 8,
      "text-padding": 6
    },
    "paint": {
      "text-color": "#4a4a4a",
      "text-halo-color": "rgba(255,255,255,.92)",
      "text-halo-width": 1.4
    }
  },
  {
    "id": "state",
    "type": "symbol",
    "source-layer": "place",
    "filter": ["==", ["get", "class"], "state"],
    "minzoom": 4,
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": 12,
      "text-letter-spacing": 0.08,
      "text-max-width": 9,
      "text-padding": 6
    },
    "paint": {
      "text-color": "#6b6b6b",
      "text-halo-color": "rgba(255,255,255,.9)",
      "text-halo-width": 1.2
    }
  },
  {
    "id": "city",
    "type": "symbol",
    "source-layer": "place",
    "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
    "minzoom": 5,
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": ["case", ["==", ["get", "class"], "city"], 13, 11.5],
      "text-max-width": 8,
      "text-padding": 4
    },
    "paint": {
      "text-color": "#3a3a3a",
      "text-halo-color": "rgba(255,255,255,.92)",
      "text-halo-width": 1.3
    }
  },
  {
    "id": "village",
    "type": "symbol",
    "source-layer": "place",
    "filter": ["in", ["get", "class"], ["literal", ["village", "hamlet"]]],
    "minzoom": 9,
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": 10.5,
      "text-max-width": 8,
      "text-padding": 4
    },
    "paint": {
      "text-color": "#555555",
      "text-halo-color": "rgba(255,255,255,.9)",
      "text-halo-width": 1.2
    }
  },
  {
    "id": "suburb",
    "type": "symbol",
    "source-layer": "place",
    "filter": [
      "in",
      ["get", "class"],
      ["literal", ["suburb", "quarter", "neighbourhood", "borough"]]
    ],
    "minzoom": 11,
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": 10.5,
      "text-max-width": 8,
      "text-padding": 4
    },
    "paint": {
      "text-color": "#5f6b7a",
      "text-halo-color": "rgba(255,255,255,.9)",
      "text-halo-width": 1.1
    }
  },
  {
    "id": "water_name",
    "type": "symbol",
    "source-layer": "water_name",
    "minzoom": 8,
    "layout": {
      "text-field": ["coalesce", ["get", "name:zh"], ["get", "name"]],
      "text-font": ["Noto Sans Regular"],
      "text-size": 11,
      "text-max-width": 7,
